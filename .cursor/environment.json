{
  "name": "adlc-demo",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "user": "ubuntu",
  "install": ".cursor/scripts/install.sh",
  "terminals": [
    {
      "name": "api",
      "command": ".cursor/scripts/start-api.sh",
      "description": ".NET 8 API on port 8080"
    },
    {
      "name": "web",
      "command": ".cursor/scripts/start-web.sh",
      "description": "Vite dev server on port 5173 (proxies /api to :8080)"
    }
  ],
  "ports": [
    { "name": "api", "port": 8080 },
    { "name": "web", "port": 5173 }
  ]
}
