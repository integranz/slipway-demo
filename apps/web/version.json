{
  "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/main/src/NerdBank.GitVersioning/version.schema.json",
  "version": "0.2",
  "publicReleaseRefSpec": [
    "^refs/heads/main$"
  ],
  "cloudBuild": {
    "buildNumber": { "enabled": true },
    "setVersionVariables": true
  },
  "pathFilters": [
    "/apps/web",
    "/.github/workflows/slipway-demo-web-ci.yml",
    "/.github/workflows/slipway-demo-web-cd.yml",
    "/.github/workflows/_ci.yml",
    "/.github/workflows/_cd.yml",
    "/infra/apps/web"
  ],
  "release": {
    "tagName": "web/v{version}",
    "branchName": "release/web-v{version}",
    "versionIncrement": "minor",
    "firstUnstableTag": "alpha"
  }
}
