# syntax=docker/dockerfile:1
# adlc-demo/web — generated by slipway (stack react-vite, base image Docker Hardened Images).
# Build:  docker build --build-arg VERSION=<semver> --build-arg COMMIT=<sha> -t adlc-demo/web:<semver> apps/web
# Runtime: nginx (distroless, user nginx uid 65532) serving the static build on 8080 and proxying /api/ to http://api (Container Apps resolves the app name through the environment proxy).
ARG NODE_VERSION=22
ARG NGINX_VERSION=1.29

FROM dhi.io/node:${NODE_VERSION}-dev AS build
ARG VERSION=0.0.0-local
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ENV VITE_APP_VERSION=${VERSION}
RUN npm run build

FROM dhi.io/nginx:${NGINX_VERSION} AS runtime
ARG VERSION=0.0.0-local
ARG COMMIT=unknown
LABEL org.opencontainers.image.title="adlc-demo/web" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.source="https://github.com/integranz/slipway-demo"
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
# the base image already runs as user nginx (uid 65532) and owns /run/nginx, /var/cache/nginx and /var/log/nginx
