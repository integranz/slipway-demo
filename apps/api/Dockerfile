# syntax=docker/dockerfile:1
# adlc-demo/api — generated by slipway (stack dotnet8-api, base image Docker Hardened Images).
# Build:  docker build --build-arg VERSION=<semver> --build-arg COMMIT=<sha> -t adlc-demo/api:<semver> apps/api
# Runtime image: distroless (no shell, no package manager), runs as uid 65532, listens on 8080.
ARG DOTNET_VERSION=8.0

FROM dhi.io/dotnet:${DOTNET_VERSION}-sdk AS build
ARG VERSION=0.0.0-local
WORKDIR /src
# restore first so dependency layers are cached independently of source changes
COPY src/Api/*.csproj src/Api/
RUN dotnet restore src/Api/Api.csproj
COPY . .
RUN dotnet publish src/Api/Api.csproj -c Release -o /out --no-restore \
      -p:Version=${VERSION} -p:InformationalVersion=${VERSION} -p:UseAppHost=false

FROM dhi.io/aspnetcore:${DOTNET_VERSION} AS runtime
ARG VERSION=0.0.0-local
ARG COMMIT=unknown
LABEL org.opencontainers.image.title="adlc-demo/api" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.source="https://github.com/integranz/slipway-demo"
WORKDIR /app
COPY --from=build --chown=65532:65532 /out ./
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_EnableDiagnostics=0
EXPOSE 8080
USER 65532
ENTRYPOINT ["dotnet", "Api.dll"]
