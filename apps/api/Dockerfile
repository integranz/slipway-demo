# syntax=docker/dockerfile:1
# adlc-demo/api — generated by slipway (stack dotnet8-api, base image Docker Hardened Images).
# Build (from the repository root): docker build --build-arg VERSION=<semver> --build-arg COMMIT=<sha> -t adlc-demo/api:<semver> -f apps/api/Dockerfile .
# The build context is the repository root because this app builds inputs outside its own path (libs/dotnet/Demo.Contracts).
# Ignore rules come from Dockerfile.dockerignore next to this file (BuildKit prefers it over the context's .dockerignore).
# Runtime image: distroless (no shell, no package manager), runs as uid 65532, listens on 8080.
ARG DOTNET_VERSION=8.0

FROM dhi.io/dotnet:${DOTNET_VERSION}-sdk AS build
ARG VERSION=0.0.0-local
WORKDIR /src
# restore first so dependency layers are cached independently of source changes
COPY apps/api/src/Api/*.csproj apps/api/src/Api/
COPY libs/dotnet/Demo.Contracts/*.csproj libs/dotnet/Demo.Contracts/
RUN dotnet restore apps/api/src/Api/Api.csproj
COPY apps/api apps/api
COPY libs/dotnet/Demo.Contracts libs/dotnet/Demo.Contracts
RUN dotnet publish apps/api/src/Api/Api.csproj -c Release -o /out --no-restore \
      -p:Version=${VERSION} -p:InformationalVersion=${VERSION} -p:UseAppHost=false

FROM dhi.io/aspnetcore:${DOTNET_VERSION} AS runtime
ARG VERSION=0.0.0-local
ARG COMMIT=unknown
LABEL org.opencontainers.image.title="adlc-demo/api" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.source="https://github.com/integranz/slipway-demo"
WORKDIR /app
COPY --from=build --chown=65532:65532 /out ./
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_EnableDiagnostics=0
EXPOSE 8080
USER 65532
ENTRYPOINT ["dotnet", "Api.dll"]
